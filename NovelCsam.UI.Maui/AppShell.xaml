<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NovelCsam.UI.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NovelCsam.UI.Maui"
    Title="Novel CSAM">
    <TabBar>
        <Tab Title="Analyze" Icon="analyze.png">
            <ShellContent
                Title="Analyze"
                ContentTemplate="{DataTemplate local:AnalyzePage}"
                Route="AnalyzePage" />
        </Tab>
        <Tab Title="Results" Icon="results.png">
            <ShellContent
                Title="Results"
                ContentTemplate="{DataTemplate local:ResultsPage}"
                Route="ResultsPage" />
        </Tab>
    </TabBar>
</Shell>
